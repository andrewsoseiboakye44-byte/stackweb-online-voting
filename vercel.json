{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" },
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/src/pages/admin/:path*",    "destination": "/admin/:path*" },
    { "source": "/src/pages/voter/:path*",    "destination": "/voter/:path*" },
    { "source": "/src/pages/operator/:path*", "destination": "/operator/:path*" }
  ],
  "redirects": [
    { "source": "/404", "destination": "/error.html", "statusCode": 200 }
  ]
}
